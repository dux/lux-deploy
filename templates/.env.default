# lux-deploy env template for every branch that is not master/main.
# Each branch is its own deploy - own directory, own units, own ports - so
# nothing here can collide with production.
#
# {{DOMAIN}} is already the branch host (see `branch_domain:` in .yaml), so
# there is nothing to prefix by hand.
#
# Real secrets belong on the server, not here:
#   lux-deploy env:set SECRET=$(openssl rand -hex 32)

RACK_ENV=production

SECRET=

DB_URL=postgresql:///myapp_{{GIT_BRANCH_UNDERSCORE}}

DOMAIN={{DOMAIN}}
