# lux-deploy env template for master/main. Every other branch uses
# .env.default (or .env.<branch>, which wins when present).
#
# Placeholders are replaced from:
#   - git:    GIT_BRANCH, GIT_BRANCH_UNDERSCORE, GIT_BRANCH_SLUG
#   - engine: PORT, DIR, RUBY, RUBY_DIR, SERVICE_USER, SERVICE_HOME,
#             APP, APP_DOMAIN, DOMAIN, HASH, TAG
#   - .yaml:  every non-behavioral key uppercased (SERVER, ...)
#
# This file is rendered fresh on every deploy, so it is the *shape* of the env.
# Real secrets belong on the server, in <app_dir>/.env.local, which is merged
# over this file and never touched by a deploy:
#
#   lux-deploy env:set SECRET=$(openssl rand -hex 32)
#   lux-deploy env:edit

RACK_ENV=production

# 64 hex chars; set it with `lux-deploy env:set SECRET=$(openssl rand -hex 32)`
# rather than committing a value here.
SECRET=

DB_URL=postgresql:///{{GIT_BRANCH_UNDERSCORE}}

# On master/main this is .yaml's `domain:` verbatim, multi-host and all.
DOMAIN={{DOMAIN}}
