# lux-deploy env template. Rendered before being uploaded to the server.
# Placeholders are replaced from:
#   - git:    GIT_BRANCH, GIT_BRANCH_UNDERSCORE
#   - engine: PORT, DIR, RUBY, RUBY_DIR
#   - .yaml:  every key uppercased (SERVER, DOMAIN, ...)

RACK_ENV=production

# 64 hex chars; generate with: openssl rand -hex 32
SECRET=replace-me

DB_URL=postgresql:///{{GIT_BRANCH_UNDERSCORE}}

# DOMAIN defaults to .yaml's `domain:`; override per-branch in .env.staging.
DOMAIN={{DOMAIN}}
